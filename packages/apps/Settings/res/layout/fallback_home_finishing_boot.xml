<?xml version="1.0" encoding="utf-8"?>
<!--
  2026-10-29 vision_app kiosk：
  原 AOSP 的 "Tablet is starting…" 文案 + 横向进度条已移除。解锁前的 HOME 占位页
  现在直接由主题 FallbackHome 的 windowBackground 显示品牌启动图（fallback_home_brand.png，
  与 bootanimation 的末帧、App 的 windowBackground 是同一张 1920x1200 素材），
  这样「开机动画 → 兜底页 → App」三段观感连续、无文字跳变。
  此处保留一个空的透明根布局：FallbackHome.onResume 后 2s 仍会 inflate 本布局，
  空布局不会覆盖窗口背景，也不会让开机动画因等待窗口绘制而延后退出。
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceHasOverlappingRendering="false" />
