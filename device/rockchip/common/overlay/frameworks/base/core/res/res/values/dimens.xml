<resources>
    <!-- 2026-10-29 vision_app kiosk：状态栏高度归零，开机全程（含 SystemUI
         启动初期）不再出现状态栏。与 config_showNavigationBar=false 同理，
         本文件会被打包成 /vendor/overlay/framework-res__auto_generated_rro_vendor.apk
         （静态 RRO），运行期覆盖 framework-res 的默认值——这是唯一生效路径，
         运行时 settings/policy_control/动态 RRO 均无法覆盖该 dimen。
         framework 中 status_bar_height 与 status_bar_height_landscape 均引用
         status_bar_height_portrait，此处三个显式归零，不依赖引用解析顺序。
         SystemUI StatusBarWindowController 读 com.android.internal.R.dimen
         .status_bar_height 决定状态栏窗口高度。 -->
    <dimen name="status_bar_height">0dp</dimen>
    <dimen name="status_bar_height_portrait">0dp</dimen>
    <dimen name="status_bar_height_landscape">0dp</dimen>
</resources>
