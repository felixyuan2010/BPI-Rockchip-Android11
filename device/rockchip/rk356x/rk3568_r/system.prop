#
# system.prop — rk3568_r
#
# 这个文件会被 build/make/core/Makefile:429 自动 append 进 /system/build.prop
# （机制：system_prop_file := $(wildcard $(TARGET_DEVICE_DIR)/system.prop)）。
# 由 init 在 first stage 加载，域为 init，对 default_prop 有完整读写权限。
#
# ⚠️ 与 rk3568_r.mk 里 PRODUCT_PROPERTY_OVERRIDES 的区别（2026-10-27 实测）：
#   本树 BoardConfig.mk:140 设了 BOARD_PROPERTY_OVERRIDES_SPLIT_ENABLED ?= true，
#   且存在独立 vendor 分区，于是 main.mk:161-166 把 PRODUCT_PROPERTY_OVERRIDES
#   改投 /vendor/build.prop。vendor/build.prop 由 vendor_init 加载，而 vendor_init
#   对 default_prop 没有 read 权限（dmesg 满屏 avc denied），结果：
#     - 行确实写进了 /vendor/build.prop
#     - getprop 却是空
#   即"属性写了但没生效，且不报错"。任何 system 命名空间的 ro.* 属性都别放那边。
#

# ---------------------------------------------------------------------------
# 以太网（docs/53 §八）：告诉 Rockchip 补丁版的 EthernetTracker 哪个网卡是主口。
#
# frameworks/base EthernetTracker.updateIfaceMatchRegexp() 先读本属性：
#     mIfaceMatch = SystemProperties.get("ro.net.eth_primary", null);
#     if (mIfaceMatch == null) { mIfaceMatch = <资源里的 eth\d>; }
# SystemProperties.get(key, null) 对**未定义**属性返回 ""（不是 null，
# android_os_SystemProperties.cpp 注释 "Legacy behavior"），所以兜底永不执行，
# mIfaceMatch 停在 ""，"eth0".matches("") 为 false → 一张网卡都不跟踪 →
# getAvailableInterfaces() 空 → Settings 的 EthernetSettings 走 mIfaceName == null
# 分支，弹 R.string.disabled_feature（"feature not available"）——
# 即使 EthernetService 本身已经在运行。
# ---------------------------------------------------------------------------
ro.net.eth_primary=eth0

# ---------------------------------------------------------------------------
# kiosk 运维通道（vision_app docs/52 §八）
# 注意：不能放 PRODUCT_PROPERTY_OVERRIDES —— 本树 BOARD_PROPERTY_OVERRIDES_SPLIT_ENABLED
# 会把它们改投 /vendor/build.prop，vendor_init 读不到 default_prop，属性静默失效。
# 本文件由 build/make/core/Makefile append 进 /system/build.prop，才会真正生效。
# ---------------------------------------------------------------------------
ro.setupwizard.mode=DISABLED
ro.adb.secure=0
persist.adb.tcp.port=5555

# ---------------------------------------------------------------------------
# 默认时区（2026-10-29）
#
# AOSP 在 persist.sys.timezone 为空时由 SystemServer 强制写成 "GMT"
# （SystemServer.java: "Timezone not set; setting to GMT."）。本产品无该属性，
# 于是整机（含 App 的时间显示）比北京时间慢 8 小时。
#
# 自动时区不可依赖：TimeZoneDetectorCallbackImpl.isAutoTimeZoneDetectionSupported()
# 只在设备有移动网络（TYPE_MOBILE）时返回 true；本机是以太网/WiFi 数据设备，
# 即使 Settings.Global.AUTO_TIME_ZONE=1，时区检测也被判为不支持 —— 只有手动
# 设置或本属性默认值生效。网络校时（NTP，config_ntpServer=2.android.pool.ntp.org）
# 只同步"时刻"，不会同步时区。
#
# 因此在这里固化默认时区。已刷机但未清 data 的机器仍保留
# /data/property 里的旧值（persist 属性优先），需执行一次：
#     adb shell cmd alarm set-timezone Asia/Shanghai
# ---------------------------------------------------------------------------
persist.sys.timezone=Asia/Shanghai
