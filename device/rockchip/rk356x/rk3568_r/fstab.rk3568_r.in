# Android fstab file.
#<src>                                          <mnt_point>         <type>    <mnt_flags and options>                       <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
${_block_prefix}system  /system   ext4 ro,barrier=1 ${_flags_vbmeta},first_stage_mount${_flags_avbpubkey}
${_block_prefix}vendor  /vendor   ext4 ro,barrier=1 ${_flags},first_stage_mount
${_block_prefix}odm     /odm      ext4 ro,barrier=1 ${_flags},first_stage_mount
${_block_prefix}product /product  ext4 ro,barrier=1 ${_flags},first_stage_mount
${_block_prefix}system_ext /system_ext  ext4 ro,barrier=1 ${_flags},first_stage_mount
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,discard,sync wait,formattable,first_stage_mount,check
/dev/block/by-name/misc         /misc               emmc      defaults     defaults
/dev/block/by-name/cache          /cache              ext4      noatime,nodiratime,nosuid,nodev,noauto_da_alloc,discard                wait,check

/devices/platform/*usb*   auto vfat defaults      voldmanaged=usb:auto

# For sata
/devices/platform/*.sata* auto vfat defaults voldmanaged=sata:auto

# For pcie ssd
/devices/platform/*.pcie* auto vfat defaults voldmanaged=pcie:auto

/dev/block/zram0                                none                swap      defaults                                              zramsize=50%
# For sdmmc
/devices/platform/${_sdmmc_device}/mmc_host*        auto  auto    defaults        voldmanaged=sdcard1:auto
#  Build10 (2026-10-22): /data as plaintext ext4, NO FBE/FDE — disabled fscrypt to
#  dodge keymaster/weaver key-unwrap failure on differently-signed firmware
#  (brick #3: cryptfs mountFstab /data Failed @8.0s -> credstore crash -> logo).
#  Build15 (2026-10-23): REVERT to f2fs + FBE to re-enable Android's NATIVE fscrypt
#  self-heal. init/builtins.cpp sets ro.crypto.type=file on FS_MGR_MNTALL_DEV_FILE/
#  METADATA_ENCRYPTED, so fscrypt_is_native()=true. A carried/factory /data (or a
#  foreign /metadata key) now fails FBE setup -> prompt_and_wipe_data ->
#  reboot_into_recovery --wipe_data, and recovery wipes BOTH /data AND /metadata
#  (bootable/recovery/.../roots.cpp "metadata. Wipe it too." + wipe_data.cpp
#  EraseVolume(/metadata)). Next boot regenerates both -> clean. This is exactly
#  SMDT's self-heal; kernel has F2FS_FS_ENCRYPTION + DM_DEFAULT_KEY + inline crypt.
#  Plaintext-ext4 line kept below as a one-line rollback if FBE misbehaves on a board.
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev${_sync_flags},discard,reserve_root=32768,resgid=1065 latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,formattable,reservedsize=128M,checkpoint=fs
#/dev/block/by-name/userdata /data ext4 discard,noatime,nosuid,nodev${_sync_flags},noauto_da_alloc,data=ordered,user_xattr,barrier=1 latemount,wait,formattable,check,quota,reservedsize=128M
