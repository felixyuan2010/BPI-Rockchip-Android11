# Provision the kiosk only after framework services are ready.
# BSP file_contexts labels the script jsy_deviceagent_provision_exec. Init
# transitions into jsy_deviceagent_provision without relying on a debug domain.
service deviceagent_do /system_ext/bin/setup_deviceagent_do.sh
    class main
    user root
    group root
    oneshot
    disabled

on property:sys.boot_completed=1
    start deviceagent_do
